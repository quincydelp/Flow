# Optional: without this, the demo uses a transparent deterministic mock agent.
OPENAI_API_KEY=
FLOW_MODEL=openai:gpt-5-mini

# Optional: Reddit OAuth application-only credentials. Without these, seeded
# finance posts are used so the workflow remains runnable and inspectable.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=desktop:flow-finance-demo:v0.1 (by /u/your_username)

